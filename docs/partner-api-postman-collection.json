      "key": "api_key",
      "value": "REPLACE_WITH_PARTNER_API_KEY"
    },
    {
      "key": "doctor_id",
      "value": "38"
    },
    {
      "key": "appointment_date",
      "value": "2026-07-12"
    },
    {
      "key": "reschedule_date",
      "value": "2026-07-13"
    },
    {
      "key": "slot_time",
      "value": "17:30"
    },
    {
      "key": "reschedule_slot_time",
      "value": "17:45"
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "department_id",
      "value": ""
    },
    {
      "key": "external_booking_id",
      "value": "POSTMAN-10001"
    },
    {
      "key": "mobile",
      "value": "9000000001"
    },
    {
