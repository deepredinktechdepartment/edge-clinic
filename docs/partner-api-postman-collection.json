      "value": "postman.test@example.com"
    },
    {
      "key": "patient_name",
      "value": "Postman Test Patient"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const pad = (value) => String(value).padStart(2, '0');",
          "const stamp = now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());",
          "if (!pm.collectionVariables.get('run_stamp')) {",
          "    pm.collectionVariables.set('run_stamp', stamp);",
          "}",
          "if (!pm.collectionVariables.get('external_booking_id') || pm.info.requestName === '03. Book Appointment') {",
          "    pm.collectionVariables.set('external_booking_id', 'POSTMAN-' + stamp);",
          "}",
          "if (!pm.collectionVariables.get('mobile') || pm.info.requestName === '03. Book Appointment') {",
          "    pm.collectionVariables.set('mobile', '9' + stamp.slice(-9));",
          "}",
          "if (!pm.collectionVariables.get('email') || pm.info.requestName === '03. Book Appointment') {",
          "    pm.collectionVariables.set('email', 'postman.' + stamp + '@example.com');",
          "}",
          "if (!pm.collectionVariables.get('patient_name')) {",
          "    pm.collectionVariables.set('patient_name', 'Postman Test Patient');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Get Doctors",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/doctors?department_id={{department_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "doctors"
          ],
          "query": [
            {
              "key": "department_id",
              "value": "{{department_id}}",
              "disabled": true
            }
          ]
        },
        "description": "Fetch active doctors available to partner APIs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Doctors array returned', function () {",
              "    pm.expect(json.data).to.be.an('array');",
              "    pm.expect(json.data.length).to.be.greaterThan(0);",
              "});",
              "const publicDoctor = (json.data || []).find(function (doctor) {",
              "    return doctor.slots_public === true;",
              "});",
              "if (publicDoctor && publicDoctor.id) {",
              "    pm.collectionVariables.set('doctor_id', String(publicDoctor.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Get Slots",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/doctors/{{doctor_id}}/slots?start_date={{appointment_date}}&end_date={{reschedule_date}}&include_unavailable=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "doctors",
            "{{doctor_id}}",
            "slots"
          ],
          "query": [
            {
              "key": "start_date",
              "value": "{{appointment_date}}"
            },
            {
              "key": "end_date",
              "value": "{{reschedule_date}}"
            },
            {
              "key": "include_unavailable",
              "value": "1"
            }
          ]
        },
        "description": "Fetch slot availability for one doctor and capture a free slot."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Dates array returned', function () {",
              "    pm.expect(json.dates).to.be.an('array');",
              "});",
              "let firstAvailable = null;",
              "let secondAvailable = null;",
              "(json.dates || []).forEach(function (dateItem) {",
              "    (dateItem.slots || []).forEach(function (slot) {",
              "        if (slot.is_available === true && !firstAvailable) {",
              "            firstAvailable = { date: dateItem.date, time: slot.time };",
              "        } else if (slot.is_available === true && firstAvailable && !secondAvailable && (dateItem.date !== firstAvailable.date || slot.time !== firstAvailable.time)) {",
              "            secondAvailable = { date: dateItem.date, time: slot.time };",
              "        }",
              "    });",
              "});",
              "pm.test('At least one available slot found', function () {",
              "    pm.expect(firstAvailable).to.not.equal(null);",
              "});",
              "if (firstAvailable) {",
              "    pm.collectionVariables.set('appointment_date', firstAvailable.date);",
              "    pm.collectionVariables.set('slot_time', firstAvailable.time);",
              "}",
              "if (secondAvailable) {",
              "    pm.collectionVariables.set('reschedule_date', secondAvailable.date);",
              "    pm.collectionVariables.set('reschedule_slot_time', secondAvailable.time);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Book Appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor_id\": {{doctor_id}},\n  \"appointment_date\": \"{{appointment_date}}\",\n  \"slot_time\": \"{{slot_time}}\",\n  \"patient_name\": \"{{patient_name}}\",\n  \"mobile\": \"{{mobile}}\",\n  \"email\": \"{{email}}\",\n  \"gender\": \"female\",\n  \"age\": \"32\",\n  \"country_code\": \"+91\",\n  \"source_name\": \"Postman Partner\",\n  \"external_booking_id\": \"{{external_booking_id}}\",\n  \"notes\": \"Booked from Postman test\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/appointments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "appointments"
          ]
        },
        "description": "Book an appointment using one free slot."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Booking created', function () {",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data.payment_id).to.exist;",
              "});",
              "if (json.data && json.data.payment_id) {",
              "    pm.collectionVariables.set('payment_id', json.data.payment_id);",
              "}",
              "if (json.data && json.data.appointment_date) {",
              "    pm.collectionVariables.set('appointment_date', json.data.appointment_date);",
              "}",
              "if (json.data && json.data.slot_time) {",
              "    pm.collectionVariables.set('slot_time', json.data.slot_time);",
              "}"
            ]
          }
        }
      ]
    },
